{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://addy.dev/liquid/schema/liquid-scene.v1.json",
  "title": "Liquid Scene",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "fixtureVersion",
    "durationMs",
    "coordinateSpace",
    "fillRule",
    "source",
    "target",
    "phases",
    "thresholds",
    "poses",
    "reducedMotion"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "fixtureVersion": { "type": "integer", "minimum": 1 },
    "durationMs": { "type": "number", "exclusiveMinimum": 0 },
    "coordinateSpace": { "$ref": "#/$defs/size" },
    "fillRule": { "enum": ["nonzero", "evenodd"] },
    "source": { "$ref": "#/$defs/endpoint" },
    "target": { "$ref": "#/$defs/endpoint" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phase" }
    },
    "thresholds": {
      "type": "array",
      "items": { "$ref": "#/$defs/threshold" }
    },
    "poses": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/pose" }
    },
    "reducedMotion": { "$ref": "#/$defs/reducedMotion" }
  },
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translateX", "translateY", "scaleX", "scaleY"],
      "properties": {
        "translateX": { "type": "number" },
        "translateY": { "type": "number" },
        "scaleX": { "type": "number" },
        "scaleY": { "type": "number" }
      }
    },
    "moveOrLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "values"],
      "properties": {
        "type": { "enum": ["M", "L"] },
        "values": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "cubic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "values"],
      "properties": {
        "type": { "const": "C" },
        "values": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    "close": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "Z" } }
    },
    "command": {
      "oneOf": [
        { "$ref": "#/$defs/moveOrLine" },
        { "$ref": "#/$defs/cubic" },
        { "$ref": "#/$defs/close" }
      ]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "shapeId", "transform", "commands"],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "shapeId": { "type": "string", "minLength": 1 },
        "transform": { "$ref": "#/$defs/transform" },
        "commands": {
          "type": "array",
          "description": "Endpoint path commands must be ordered as M-started contours. L, C, and Z require an open contour; after Z, the next drawable contour must start with M.",
          "minItems": 2,
          "items": { "$ref": "#/$defs/command" }
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "end"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0, "maximum": 1 },
        "end": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "at": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "radius"],
      "properties": {
        "start": { "$ref": "#/$defs/point" },
        "end": { "$ref": "#/$defs/point" },
        "radius": { "type": "number", "minimum": 0 }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor",
        "leftLeg",
        "rightLeg",
        "crossbar",
        "bridge",
        "blendRadius",
        "targetMix",
        "cornerSharpness"
      ],
      "properties": {
        "anchor": { "$ref": "#/$defs/point" },
        "leftLeg": { "$ref": "#/$defs/capsule" },
        "rightLeg": { "$ref": "#/$defs/capsule" },
        "crossbar": { "$ref": "#/$defs/capsule" },
        "bridge": { "$ref": "#/$defs/capsule" },
        "blendRadius": { "type": "number", "minimum": 0 },
        "targetMix": { "type": "number", "minimum": 0, "maximum": 1 },
        "cornerSharpness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "easing", "frame"],
      "properties": {
        "at": { "type": "number", "minimum": 0, "maximum": 1 },
        "easing": {
          "enum": ["linear", "smoothStep", "smootherStep", "easeInCubic", "easeOutCubic"]
        },
        "frame": { "$ref": "#/$defs/frame" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "description": "For crossfade reduced motion, fadeStart must be less than fadeEnd.",
      "additionalProperties": false,
      "required": ["mode", "durationMs", "fadeStart", "fadeEnd"],
      "properties": {
        "mode": { "const": "crossfade" },
        "durationMs": { "type": "number", "exclusiveMinimum": 0 },
        "fadeStart": { "type": "number", "minimum": 0, "maximum": 1 },
        "fadeEnd": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
