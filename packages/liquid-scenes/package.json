{
  "name": "@liquid/scenes",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "assets",
    "index.d.ts",
    "index.js",
    "resources.manifest.json",
    "samples",
    "scenes"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./capsule-to-a": "./scenes/capsule-to-a.v1.json",
    "./spinner-to-ad": "./scenes/spinner-to-ad.v2.json",
    "./spinner-to-addy": "./scenes/spinner-to-addy.v2.json",
    "./addy-logo-wave": "./scenes/addy-logo-wave.v2.json",
    "./addy-logo-wave-wordmark": "./scenes/addy-logo-wave-wordmark.v2.json",
    "./addy-logo-wave-wordmark-replay": "./scenes/addy-logo-wave-wordmark-replay.v2.json",
    "./assets/manifest": "./assets/manifest.json",
    "./assets/*": "./assets/*",
    "./samples/capsule-to-a": "./samples/capsule-to-a.samples.json",
    "./samples/spinner-to-ad": "./samples/spinner-to-ad.samples.json",
    "./samples/spinner-to-addy": "./samples/spinner-to-addy.samples.json",
    "./samples/addy-logo-wave": "./samples/addy-logo-wave.samples.json",
    "./samples/addy-logo-wave-wordmark": "./samples/addy-logo-wave-wordmark.samples.json",
    "./samples/addy-logo-wave-wordmark-replay": "./samples/addy-logo-wave-wordmark-replay.samples.json",
    "./resources/manifest": "./resources.manifest.json"
  },
  "scripts": {
    "prepack": "node ../../tools/sync-scene-resources.mjs --check"
  }
}
