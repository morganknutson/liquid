{
  "name": "liquid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "assets:check": "node tools/canonicalize-assets.mjs --check",
    "assets:generate": "node tools/canonicalize-assets.mjs",
    "benchmark": "npm run benchmark:web && npm run benchmark:swift",
    "benchmark:browser": "npm run build && node tools/benchmark-browser.mjs",
    "benchmark:swift": "swift run -c release LiquidBenchmark",
    "benchmark:web": "npm run build && node tools/benchmark.mjs",
    "build": "npm run build --workspaces --if-present",
    "dump:ts": "node tools/dump-ts.mjs",
    "parity": "npm run parity:v1 && npm run parity:v2 && npm run parity:full && npm run parity:wave && npm run parity:wave-wordmark",
    "parity:full": "node tools/run-parity.mjs --scene shared/scenes/spinner-to-addy.v2.json --samples shared/golden/spinner-to-addy.samples.json",
    "parity:wave": "node tools/run-parity.mjs --scene shared/scenes/addy-logo-wave.v2.json --samples shared/golden/addy-logo-wave.samples.json",
    "parity:wave-wordmark": "node tools/run-parity.mjs --scene shared/scenes/addy-logo-wave-wordmark.v2.json --samples shared/golden/addy-logo-wave-wordmark.samples.json",
    "parity:v1": "node tools/run-parity.mjs --scene shared/scenes/capsule-to-a.v1.json --samples shared/golden/capsule-to-a.samples.json",
    "parity:v2": "node tools/run-parity.mjs --scene shared/scenes/spinner-to-ad.v2.json --samples shared/golden/spinner-to-ad.samples.json",
    "scene:addy": "node tools/author-spinner-to-addy.mjs",
    "scene:addy:check": "node tools/author-spinner-to-addy.mjs --check",
    "resources:check": "node tools/sync-scene-resources.mjs --check",
    "resources:generate": "node tools/sync-scene-resources.mjs",
    "test": "npm run test:unit && npm run test:node && npm run test:contract",
    "test:contract": "npm run parity",
    "test:e2e": "playwright test",
    "test:node": "node --test tools/*.test.mjs",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build && npm run visual:check && npm run resources:check && npm run scene:addy:check",
    "visual:check": "npm run build && npm run visual:check:v1 && npm run visual:check:v2 && npm run visual:check:full && npm run visual:check:wave && npm run visual:check:wave-wordmark",
    "visual:check:wave": "node tools/generate-visual-golden.mjs --scene shared/scenes/addy-logo-wave.v2.json --samples shared/golden/addy-logo-wave.samples.json --out shared/golden/addy-logo-wave.visual.json --resolution 132x70 --resolution 264x139 --check",
    "visual:check:wave-wordmark": "node tools/generate-visual-golden.mjs --scene shared/scenes/addy-logo-wave-wordmark.v2.json --samples shared/golden/addy-logo-wave-wordmark.samples.json --out shared/golden/addy-logo-wave-wordmark.visual.json --resolution 132x70 --resolution 264x139 --check",
    "visual:check:full": "node tools/generate-visual-golden.mjs --scene shared/scenes/spinner-to-addy.v2.json --samples shared/golden/spinner-to-addy.samples.json --out shared/golden/spinner-to-addy.visual.json --resolution 132x70 --resolution 264x139 --check",
    "visual:check:v1": "node tools/generate-visual-golden.mjs --check",
    "visual:check:v2": "node tools/generate-visual-golden.mjs --scene shared/scenes/spinner-to-ad.v2.json --samples shared/golden/spinner-to-ad.samples.json --out shared/golden/spinner-to-ad.visual.json --resolution 132x52 --resolution 264x104 --check",
    "visual:generate": "npm run build && npm run visual:generate:v1 && npm run visual:generate:v2 && npm run visual:generate:full && npm run visual:generate:wave && npm run visual:generate:wave-wordmark",
    "visual:generate:wave": "node tools/generate-visual-golden.mjs --scene shared/scenes/addy-logo-wave.v2.json --samples shared/golden/addy-logo-wave.samples.json --out shared/golden/addy-logo-wave.visual.json --resolution 132x70 --resolution 264x139",
    "visual:generate:wave-wordmark": "node tools/generate-visual-golden.mjs --scene shared/scenes/addy-logo-wave-wordmark.v2.json --samples shared/golden/addy-logo-wave-wordmark.samples.json --out shared/golden/addy-logo-wave-wordmark.visual.json --resolution 132x70 --resolution 264x139",
    "visual:generate:full": "node tools/generate-visual-golden.mjs --scene shared/scenes/spinner-to-addy.v2.json --samples shared/golden/spinner-to-addy.samples.json --out shared/golden/spinner-to-addy.visual.json --resolution 132x70 --resolution 264x139",
    "visual:generate:v1": "node tools/generate-visual-golden.mjs",
    "visual:generate:v2": "node tools/generate-visual-golden.mjs --scene shared/scenes/spinner-to-ad.v2.json --samples shared/golden/spinner-to-ad.samples.json --out shared/golden/spinner-to-ad.visual.json --resolution 132x52 --resolution 264x104"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
